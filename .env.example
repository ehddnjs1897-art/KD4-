TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# 단일 사용자: TELEGRAM_ALLOWED_USER_ID=123456789
# 다중 사용자 (첫 번째 = 관리자): TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
TELEGRAM_ALLOWED_USER_IDS=your_id,employee_id
CLAUDE_MODEL=claude-opus-4-7
WORKSPACE_DIR=/Users/yourname
DAILY_REPORT_HOUR=9
AUTO_WORK_HOURS=8,10,12,14,16,18,20,22
NIGHT_WORK_HOUR=2

# Notion 회의록 저장
# 1. https://www.notion.so/my-integrations 에서 Integration 생성 → Secret 복사
# 2. 저장할 Notion 페이지 우상단 ··· → Connections → Integration 추가
# 3. 해당 페이지 URL에서 ID 복사 (notion.so/[ID]?... 형식)
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_PARENT_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
